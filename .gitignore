.venv/
__pycache__/
*.pyc
.DS_Store
.claude/
# Working notes
notes/
# Run logs
logs/
# Activation caches are large and regenerable
*.npz
*.pt
# Raw model replies and judge output may contain harmful text; only aggregate summaries are tracked
results/**/*.jsonl
results/earlier_neuron_steering/
# Harmful-request text is fetched from the upstream benchmark, not redistributed here
data/external/multijail/
data/rendered/multijail_*.jsonl
data/rendered/xstest_unsafe_*.jsonl
# Copies of pod results made by the local dashboard
results_pod/
# Translated benchmark prompts, including unsafe contrast items
data/rendered/xstest_v*
data/translations/
data/rendered/xstest_s3_*
data/rendered/s3_items.jsonl
data/external/multilingual_harmless_harmful/
data/external/indicguard/
data/external/indicsafe/
data/external/surakshaeval/
data/external/banglashield/
data/manifest/manifest.jsonl
data/rendered/baseline_items.jsonl
data/rendered/gated_items.jsonl
data/rendered/gated2_items.jsonl
# v2 dataset items contain harmful text; only summaries are tracked
data/v2/*.jsonl
data/external/aya_redteaming/
data/external/polyguard/
data/v2/direction_labels.json
results/v2/direction/direction.npz
